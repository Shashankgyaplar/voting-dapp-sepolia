# Copy to .env and fill these values before deploying to Sepolia
ALCHEMY_API_KEY=your_alchemy_api_key_here
# or alternatively you can set SEPOLIA_RPC_URL with full RPC endpoint
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_ID

# Private key of deployer (without 0x). For example:
PRIVATE_KEY=your_private_key_without_0x
